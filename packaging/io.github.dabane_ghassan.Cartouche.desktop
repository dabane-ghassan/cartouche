[Desktop Entry]
Type=Application
Name=Cartouche
GenericName=Dynamic Island
Comment=A Dynamic Island for the GNOME top bar
Exec=cartouche settings
Icon=io.github.dabane_ghassan.Cartouche
Terminal=false
Categories=Utility;GNOME;Settings;
